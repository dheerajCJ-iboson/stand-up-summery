# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Default Git Configuration
DEFAULT_GIT_AUTHOR="Dheeraj C Justine <dheeraj.justine@ibosoninnov.com>"
DEFAULT_REPO_PATH="C:\Users\Dheeraj\Documents\way-carwash-hub"

# LLM provider: gemini (default) | ollama | openai (any OpenAI-compatible API)
# LLM_PROVIDER=gemini
# Optional; defaults: gemini-2.5-flash / gemma4:31b-cloud / gpt-4o-mini
# LLM_MODEL=gemma4:31b-cloud

# Ollama (cloud models run via the local daemon after `ollama signin`)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_API_KEY=            # only when calling https://ollama.com directly

# OpenAI-compatible
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Fallback provider used if the primary fails
# LLM_FALLBACK_PROVIDER=ollama
# LLM_FALLBACK_MODEL=gemma4:31b-cloud

# Optional behaviour
# OUTPUT_FORMAT=markdown        # slack | markdown | plain
# VERIFY=true                   # fact-check the summary with a second LLM pass
# USE_GH_PRS=true               # include GitHub PR titles (needs the gh CLI)
# DIFF_CHARS=1200               # max diff characters sent per commit
# SLACK_WEBHOOK_URL=            # enables --post
